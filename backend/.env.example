# OilCrop Intelligence Environment Configuration
PROJECT_NAME="OilCrop Intelligence"
API_V1_STR="/api"
SECRET_KEY="oilcrop_intelligence_super_secret_jwt_key_for_development_replace_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses PostgreSQL. If PostgreSQL is unreachable or credentials are not supplied,
# system automatically falls back to local SQLite with WAL enabled for seamless development and evaluation.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oilcrop_db
FALLBACK_SQLITE_URL=sqlite:///./oilcrop_intelligence.db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Admin Seed
ADMIN_EMAIL=admin@oilcrop.org
ADMIN_PASSWORD=AdminOilCrop2025!
ADMIN_NAME="System Administrator"
